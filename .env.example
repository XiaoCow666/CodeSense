# 数据库配置
DATABASE_URL='mysql+pymysql://user:password@127.0.0.1:3306/codesense'

# 应用密钥（生产环境必须设置，至少32个字符）
SECRET_KEY='your_secret_key_here_change_in_production'

# AI API配置（至少配置一个）
ZHIPU_API_KEY='your_zhipu_api_key_here'
OPENAI_API_KEY='your_openai_api_key_here'
# 多 provider 时按顺序自动切换；只配置一个时无需修改
AI_PROVIDER_ORDER='zhipu,openai'
ZHIPU_MODEL='glm-4.5-flash'
OPENAI_MODEL='gpt-4-turbo'

# 密码找回邮件（未配置时，管理员仍可在用户管理页生成一次性重置链接）
MAIL_SERVER=''
MAIL_PORT='587'
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_USE_TLS='true'
MAIL_USE_SSL='false'
MAIL_DEFAULT_SENDER=''
MAIL_TIMEOUT_SECONDS='10'
# 用于生成邮件和管理员复制的绝对链接，线上请填写真实 HTTPS 地址
APP_BASE_URL=''
PASSWORD_RESET_TOKEN_TTL_MINUTES='30'
PASSWORD_RESET_REQUEST_INTERVAL_SECONDS='60'

# AI 网络传输（可选）
# 如果 TUN 使用 Fake-IP，且 Python 进程不能直接访问外网，填写本机 HTTP
# 代理，例如 http://127.0.0.1:7890；配置后需要重启 app.py。
# 也可以使用标准 HTTPS_PROXY/HTTP_PROXY，httpx 会自动读取。
# AI_HTTPS_PROXY='http://127.0.0.1:7890'
# ZHIPU_HTTPS_PROXY='http://127.0.0.1:7890'
# AI_CONNECT_TIMEOUT_SECONDS='8'
# AI_READ_TIMEOUT_SECONDS='120'
# AI_WRITE_TIMEOUT_SECONDS='30'
# AI_POOL_TIMEOUT_SECONDS='10'

# AI 稳定性参数（默认值适合本地开发）
AI_RETRY_ATTEMPTS='3'
AI_MAX_CONCURRENT_REQUESTS='3'
# 交互轮次优先快速失败；后台能力分析使用独立的重试/排队预算
AI_INTERACTIVE_RETRY_ATTEMPTS='2'
AI_BACKGROUND_RETRY_ATTEMPTS='2'
AI_CIRCUIT_FAILURE_THRESHOLD='2'
AI_CIRCUIT_COOLDOWN_SECONDS='30'
AI_REQUEST_QUEUE_TIMEOUT_SECONDS='2'
AI_INTERACTIVE_QUEUE_TIMEOUT_SECONDS='1'
AI_BACKGROUND_QUEUE_TIMEOUT_SECONDS='0.5'
AI_CACHE_TTL_SECONDS='86400'
AI_SINGLEFLIGHT_WAIT_SECONDS='90'
AI_SLOW_REQUEST_LOG_SECONDS='5'

# 阶段3 Agent 框架（默认 native；安装 requirements-crewai.txt 后可试 crewai）
STAGE3_AGENT_FRAMEWORK='native'
# 结合实际回复长度控制结构化交互输出，避免无意义长回复占用模型通道
STAGE3_MODEL_MAX_TOKENS='700'
# CrewAI 实验默认关闭其额外遥测，避免增加外部网络依赖
CREWAI_DISABLE_TELEMETRY='true'
CREWAI_TRACING_ENABLED='false'

# 应用配置
PORT=8000
HOST=0.0.0.0
FLASK_CONFIG='development'
FLASK_DEBUG='False'

# 数据库连接池（每个 Web worker 的连接数；总连接数约为
# WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)）
DB_POOL_SIZE='3'
DB_MAX_OVERFLOW='2'
DB_POOL_TIMEOUT='10'
DB_POOL_RECYCLE='1800'
# 开发/测试可开启；生产建议先运行 database_maintenance.py，再保持关闭
AUTO_INIT_DB='1'
DB_ENSURE_INDEXES='1'

# 后台任务（当前为进程内轻量队列，多 worker 会各自拥有一套队列）
ASYNC_TASKS_ENABLED='1'
ASYNC_WORKER_COUNT='1'
ASYNC_MAX_QUEUE_SIZE='1000'
PRESET_SCAN_ENABLED='1'
PRESET_SCAN_BATCH_SIZE='20'

# Web 层性能
ACCESS_LOG_ENABLED='1'
SLOW_REQUEST_MS='800'
STATIC_CACHE_SECONDS='3600'
ENABLE_RESPONSE_COMPRESSION='0'

# 安全配置
# 本地通过 HTTP 启动时保持 false；线上 HTTPS 部署必须改为 true
SECURE_COOKIES='false'
# 线上 Nginx -> Gunicorn 反向代理必须启用；本地直连开发环境保持 false
TRUST_PROXY_HEADERS='false'
# 当前线上拓扑只有一层 Nginx 代理，不要随意增大该值
PROXY_FIX_HOPS='1'
