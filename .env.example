# 数据库配置
DATABASE_URL='mysql+pymysql://user:password@127.0.0.1:3306/codesense'

# 应用密钥（生产环境必须设置，至少32个字符）
SECRET_KEY='your_secret_key_here_change_in_production'

# AI API配置（至少配置一个）
ZHIPU_API_KEY='your_zhipu_api_key_here'
OPENAI_API_KEY='your_openai_api_key_here'
# 多 provider 时按顺序自动切换；只配置一个时无需修改
AI_PROVIDER_ORDER='zhipu,openai'
ZHIPU_MODEL='glm-4.5-flash'
OPENAI_MODEL='gpt-4-turbo'

# AI 稳定性参数（默认值适合本地开发）
AI_RETRY_ATTEMPTS='3'
AI_MAX_CONCURRENT_REQUESTS='3'
AI_CIRCUIT_FAILURE_THRESHOLD='2'
AI_CIRCUIT_COOLDOWN_SECONDS='30'
# Interactive streams fail over quickly instead of waiting on a stalled
# provider for several minutes or stacking SDK retries.
AI_PROVIDER_TIMEOUT_SECONDS='30'
AI_STREAM_RETRY_ATTEMPTS='1'
AI_REQUEST_QUEUE_TIMEOUT_SECONDS='2'
AI_CACHE_TTL_SECONDS='86400'
AI_SINGLEFLIGHT_WAIT_SECONDS='90'

# 应用配置
PORT=8000
HOST=0.0.0.0
FLASK_CONFIG='development'
FLASK_DEBUG='False'

# 数据库连接池（每个 Web worker 的连接数；总连接数约为
# WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)）
DB_POOL_SIZE='3'
DB_MAX_OVERFLOW='2'
DB_POOL_TIMEOUT='10'
DB_POOL_RECYCLE='1800'
# 开发/测试可开启；生产建议先运行 database_maintenance.py，再保持关闭
AUTO_INIT_DB='1'
DB_ENSURE_INDEXES='1'

# 后台任务（当前为进程内轻量队列，多 worker 会各自拥有一套队列）
ASYNC_TASKS_ENABLED='1'
ASYNC_WORKER_COUNT='1'
ASYNC_MAX_QUEUE_SIZE='1000'
PRESET_SCAN_ENABLED='1'
PRESET_SCAN_BATCH_SIZE='20'

# Web 层性能
ACCESS_LOG_ENABLED='1'
SLOW_REQUEST_MS='800'
STATIC_CACHE_SECONDS='3600'
ENABLE_RESPONSE_COMPRESSION='0'

# 安全配置
# 本地通过 HTTP 启动时保持 false；线上 HTTPS 部署必须改为 true
SECURE_COOKIES='false'
# 线上 Nginx -> Gunicorn 反向代理必须启用；本地直连开发环境保持 false
TRUST_PROXY_HEADERS='false'
# 当前线上拓扑只有一层 Nginx 代理，不要随意增大该值
PROXY_FIX_HOPS='1'

# 可选：提交评测外部队列（默认 thread=Web 进程内线程执行，无需 Redis）
# 仅当需要把"非 demo 的提交评测"交给独立 worker 进程执行时才改为 rq；
# 改为 rq 后 SUBMISSION_EVALUATION_REDIS_URL 必填，否则应用启动校验直接失败
# （见 config.py 中 *_QUEUE_BACKEND 的取值校验）。
# SUBMISSION_EVALUATION_QUEUE_BACKEND='thread'
# SUBMISSION_EVALUATION_REDIS_URL=''
# SUBMISSION_EVALUATION_QUEUE_NAME='submission-evaluation'
# SUBMISSION_EVALUATION_QUEUE_TTL='300'

# 可选：能力分析外部队列（约束同上）
# ABILITY_ANALYSIS_QUEUE_BACKEND='thread'
# ABILITY_ANALYSIS_REDIS_URL=''
# ABILITY_ANALYSIS_QUEUE_NAME='ability-analysis'
# ABILITY_ANALYSIS_QUEUE_TTL='300'
# 以上两个 *_QUEUE_TTL 取值范围均为 30-86400 秒，默认 300。

# 可选：会话 Redis。不设置时默认尝试 redis://127.0.0.1:6379/0，
# 连接失败或未安装 redis 库时自动降级为文件系统会话（见 app.py）。
# REDIS_URL='redis://127.0.0.1:6379/0'

# 可选：独立评测 worker 的配置档名。worker 进程读取 CODESENSE_CONFIG（默认
# production），Web 进程读取 FLASK_CONFIG；单机部署通常无需设置
# （见 tasks/submission_worker.py 与 codesense-*-worker.service）。
# CODESENSE_CONFIG='production'
